      ],
      "vision_title_1": [
        {
          "text": "Tarımın"
        }
      ],
      "vision_title_2": [
        {
          "text": "yarınında"
        }
      ],
      "vision_title_accent": [
        {
          "text": "kalıcı değer."
        }
      ],
      "vision_caption": [
        {
          "text": "Vizyonumuz"
        }
      ],
      "vision_description": [
        {
          "text": "Tarımın değişen ihtiyaçlarına yenilikçi ve güvenilir çözümlerle cevap veren; üreticiyle birlikte gelişen, sürdürülebilir üretimi destekleyen güçlü bir yapı olmayı hedefliyoruz."
        }
      ],
      "mission_index": [
        {
          "text": "02 / Misyon"
        }
      ],
      "mission_title_1": [
        {
          "text": "Değeri"
        }
      ],
      "mission_title_2": [
        {
          "text": "topraktan"
        }
      ],
      "mission_title_accent": [
        {
          "text": "başlatmak."
        }
      ],
      "mission_caption": [
        {
          "text": "Misyonumuz"
        }
      ],
      "mission_description": [
        {
          "text": "Üreticinin ihtiyaçlarını doğru anlamak, sahada karşılığı olan çözümler geliştirmek ve kaliteyi sürdürülebilirlikle birleştirerek üretimin her aşamasına uzun vadeli değer katmak için çalışıyoruz."
        }
      ],
