      ],
      "intro_title_1": [
        {
          "text": "We understand the soil."
        }
      ],
      "intro_title_2": [
        {
          "text": "We grow together."
        }
      ],
      "start_year": [
        {
          "text": "2001"
        }
      ],
      "start_year_description": [
        {
          "text": "The first year of our journey rooted in the soil."
        }
      ],
      "intro_description": [
        {
          "text": "We began by understanding the real needs of agriculture in the field. We listened to the soil, learned from producers and evolved with changing conditions. Today, we turn years of experience into a more productive, reliable and sustainable approach to production."
        }
      ],
      "intro_tag_1": [
        {
          "text": "Experience from the field"
        }
      ],
      "intro_tag_2": [
        {
          "text": "Growing with producers"
        }
      ],
      "story_section_label": [
        {
          "text": "About us"
        }
      ],
      "story_title_1": [
        {
          "text": "We see agriculture"
        }
      ],
      "story_title_accent": [
        {
          "text": "as a cycle"
        }
      ],
      "story_title_3": [
        {
          "text": "of connected value."
        }
      ],
      "story_description": [
        {
          "text": "We believe every stage, from preparing the soil to sustaining production, is connected. Our approach is shaped by this whole."
        }
      ],
      "statement_1_label": [
        {
          "text": "Beginning"
        }
      ],
      "statement_1_text": [
        {
          "text": "Production cannot be understood without understanding the soil."
        }
      ],
      "statement_2_label": [
        {
          "text": "Growth"
        }
      ],
      "statement_2_text": [
        {
          "text": "We grow knowledge through experience in the field."
        }
      ],
      "statement_3_label": [
        {
          "text": "Future"
        }
      ],
      "statement_3_text": [
        {
          "text": "We protect tomorrow’s soil while producing today."
        }
      ],
      "general_label": [
        {
          "text": "Our Journey"
        }
      ],
      "general_period": [
        {
          "text": "2001 — Today"
        }
      ],
      "scroll_label": [
        {
          "text": "Scroll"
        }
      ],
      "history_1_title_1": [
        {
          "text": "In 2001, we set out"
        }
      ],
      "history_1_title_2": [
        {
          "text": "with trust in the soil."
        }
      ],
      "history_1_body_1": [
        {
          "text": "We began by observing the real needs of producers in the field."
        }
      ],
      "history_1_body_2": [
        {
          "text": "We learned that soil, climate and production cannot be considered separately."
        }
      ],
      "history_1_body_3": [
        {
          "text": "Reliability and continuity have remained central to the way we work."
        }
      ],
      "history_2_title_1": [
        {
          "text": "We learned in the field"
        }
      ],
      "history_2_title_2": [
        {
          "text": "and grew through experience."
        }
      ],
      "history_2_body_1": [
        {
          "text": "Every season taught us to understand production again."
        }
      ],
      "history_2_body_2": [
        {
          "text": "We responded to changing conditions with knowledge and experience as well as products."
        }
      ],
      "history_2_body_3": [
        {
          "text": "Our relationship with producers became one of our strongest sources of growth."
        }
      ],
      "history_3_title_1": [
        {
          "text": "We turned knowledge into production"
        }
      ],
      "history_3_title_2": [
        {
          "text": "and production into value."
        }
      ],
      "history_3_body_1": [
        {
          "text": "We brought traditional agricultural knowledge together with current production methods."
        }
      ],
      "history_3_body_2": [
        {
          "text": "We focused on practical and sustainable solutions that work in the field."
        }
      ],
      "history_3_body_3": [
        {
          "text": "At every step, we valued continuity as much as productivity."
        }
      ],
      "history_4_title_1": [
        {
          "text": "Today, we work"
        }
      ],
      "history_4_title_2": [
        {
          "text": "for the agriculture of tomorrow."
        }
      ],
      "history_4_body_1": [
        {
          "text": "We meet today’s needs while considering the soil of tomorrow."
        }
      ],
      "history_4_body_2": [
        {
          "text": "We support an approach that uses resources responsibly and strengthens producers."
        }
      ],
      "history_4_body_3": [
        {
          "text": "We continue to unite our experience with the production methods of the future."
        }
      ],
      "vision_mission_label": [
        {
          "text": "Vision & Mission"
        }
      ],
      "vision_index": [
        {
          "text": "01 / Vision"
        }
      ],
      "vision_title_1": [
        {
          "text": "Lasting"
        }
      ],
      "vision_title_2": [
        {
          "text": "value in agriculture’s"
        }
      ],
      "vision_title_accent": [
        {
          "text": "future."
        }
      ],
      "vision_caption": [
        {
          "text": "Our vision"
        }
      ],
      "vision_description": [
        {
          "text": "We aim to be a strong organization that responds to agriculture’s changing needs with innovative and reliable solutions, grows with producers and supports sustainable production."
        }
      ],
      "mission_index": [
        {
          "text": "02 / Mission"
        }
      ],
      "mission_title_1": [
        {
          "text": "Creating"
        }
      ],
      "mission_title_2": [
        {
          "text": "value from"
        }
      ],
      "mission_title_accent": [
        {
          "text": "the soil."
        }
      ],
      "mission_caption": [
        {
          "text": "Our mission"
        }
      ],
      "mission_description": [
        {
          "text": "We work to understand producers’ needs, develop practical solutions and add lasting value to every stage of production by combining quality with sustainability."
        }
      ],
      "closing_brand": [
        {
          "text": "Toprak Tarım"
        }
      ],
      "motto_label": [
        {
          "text": "Our motto"
        }
      ],
      "slogan_word_1": [
        {
          "text": "Abundance"
        }
      ],
      "slogan_word_2": [
        {
          "text": "Comes From"
        }
      ],
      "slogan_word_3": [
        {
          "text": "The Soil."
        }
      ],
      "slogan_description": [
        {
          "text": "Respect for the soil is at the heart of everything we do. We work to add value to producers’ efforts and shape the agriculture of tomorrow together."
        }
      ],
      "closing_bottom_1": [
        {
          "text": "Respect for soil. Value for production."
        }
      ],
      "closing_bottom_2": [
        {
          "text": "Together, towards the future."
        }
      ],
