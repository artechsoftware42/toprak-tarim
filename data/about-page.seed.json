      "slogan_description": [
        {
          "text": "Toprağa duyduğumuz saygı, yaptığımız her işin temelinde. Üreticinin emeğine değer katmak ve yarının tarımını birlikte geliştirmek için çalışıyoruz."
        }
      ],
      "closing_bottom_1": [
