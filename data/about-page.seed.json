        {
          "text": "Toprakla başlayan yolculuğumuzun ilk yılı."
        }
      ],
      "intro_description": [
        {
          "text": "Tarımın gerçek ihtiyaçlarını sahada anlayarak başladık. Toprağı dinledik, üreticiden öğrendik ve değişen koşullarla birlikte geliştik. Bugün yılların deneyimini daha verimli, güvenilir ve sürdürülebilir bir üretim anlayışına dönüştürüyoruz."
        }
      ],
      "intro_tag_1": [
        {
          "text": "Sahadan gelen deneyim"
        }
      ],
      "intro_tag_2": [
        {
          "text": "Üreticiyle birlikte gelişim"
        }
      ],
      "story_section_label": [
        {
          "text": "Hakkımızda"
        }
      ],
      "story_title_1": [
        {
          "text": "Tarımı bir"
        }
      ],
      "story_title_accent": [
        {
          "text": "döngü"
        }
      ],
      "story_title_3": [
        {
          "text": "olarak görüyoruz."
        }
      ],
      "story_description": [
        {
          "text": "Toprağın hazırlanmasından üretimin sürdürülebilirliğine kadar her aşamanın birbiriyle bağlantılı olduğuna inanıyoruz. Yaklaşımımız bu bütünlüğün içinde şekilleniyor."
        }
      ],
      "statement_1_label": [
        {
          "text": "Başlangıç"
        }
      ],
      "statement_1_text": [
        {
          "text": "Toprağı anlamadan üretimi anlamak mümkün değil."
        }
      ],
      "statement_2_label": [
        {
          "text": "Gelişim"
        }
      ],
      "statement_2_text": [
        {
          "text": "Bilgiyi sahadaki deneyimle büyütüyoruz."
        }
      ],
      "statement_3_label": [
        {
          "text": "Gelecek"
        }
      ],
      "statement_3_text": [
        {
          "text": "Üretirken geleceğin toprağını da koruyoruz."
        }
      ],
      "general_label": [
        {
          "text": "Genel Bilgiler"
        }
      ],
      "general_period": [
        {
          "text": "2001 — Bugün"
        }
      ],
      "scroll_label": [
        {
          "text": "Kaydır"
        }
      ],
      "history_1_title_1": [
        {
          "text": "2001’de toprağa"
        }
      ],
      "history_1_title_2": [
        {
          "text": "güvenerek yola çıktık."
        }
      ],
      "history_1_body_1": [
        {
          "text": "Üreticinin gerçek ihtiyaçlarını sahada görerek başladık."
        }
      ],
      "history_1_body_2": [
        {
          "text": "Toprağın, iklimin ve üretimin birbirinden ayrı düşünülemeyeceğini öğrendik."
        }
      ],
      "history_1_body_3": [
        {
          "text": "İlk günden beri güvenilirlik ve süreklilik çalışma anlayışımızın merkezinde yer aldı."
        }
      ],
      "history_2_title_1": [
        {
          "text": "Sahada öğrendik,"
        }
      ],
      "history_2_title_2": [
        {
          "text": "deneyimle büyüdük."
        }
      ],
      "history_2_body_1": [
        {
          "text": "Her sezon bize üretimi yeniden okumayı öğretti."
        }
      ],
      "history_2_body_2": [
        {
          "text": "Değişen koşullara yalnızca ürünlerle değil, bilgi ve deneyimle cevap verdik."
        }
      ],
      "history_2_body_3": [
        {
          "text": "Üreticiyle kurduğumuz ilişki gelişimimizin en önemli kaynaklarından biri oldu."
        }
      ],
      "history_3_title_1": [
        {
          "text": "Bilgiyi üretime,"
        }
      ],
      "history_3_title_2": [
        {
          "text": "üretimi değere dönüştürdük."
        }
      ],
      "history_3_body_1": [
        {
          "text": "Geleneksel tarım bilgisini güncel üretim yaklaşımlarıyla bir araya getirdik."
        }
      ],
      "history_3_body_2": [
        {
          "text": "Sahada karşılığı olan, uygulanabilir ve sürdürülebilir çözümler geliştirmeye odaklandık."
        }
      ],
      "history_3_body_3": [
        {
          "text": "Her adımda verim kadar üretimin devamlılığını da önemsedik."
        }
      ],
      "history_4_title_1": [
        {
          "text": "Bugün geleceğin tarımı"
        }
      ],
      "history_4_title_2": [
        {
          "text": "için çalışıyoruz."
        }
      ],
      "history_4_body_1": [
        {
          "text": "Bugünün ihtiyaçlarını karşılarken yarının toprağını da hesaba katıyoruz."
        }
      ],
      "history_4_body_2": [
        {
          "text": "Kaynakların doğru kullanıldığı, üreticinin güçlendiği bir tarım anlayışını destekliyoruz."
        }
      ],
      "history_4_body_3": [
        {
          "text": "Geçmişten gelen deneyimimizi geleceğin üretim biçimleriyle buluşturmaya devam ediyoruz."
        }
      ],
      "vision_mission_label": [
        {
          "text": "Vizyon & Misyon"
        }
