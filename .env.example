# Copy to .env.local at the project root. Never commit real credentials.
MONGODB_URI_TEST=
MONGODB_URI=
MONGODB_DB=toprak-tarim

# Public origin used by canonical URLs, hreflang, robots.txt and sitemap.xml.
# Use the temporary Hostinger origin for staging, then replace it with the final domain.
NEXT_PUBLIC_SITE_URL=https://example.com
# Keep false on the temporary review domain. Set true only when the final domain is ready to be indexed.
SITE_INDEXING_ENABLED=false
# Optional Google Search Console ownership token (the token only, not the full meta tag).
GOOGLE_SITE_VERIFICATION=

# Contact form mail delivery (server-side only).
RESEND_API_KEY=
RESEND_FROM=Toprak Tarım <iletisim@your-verified-domain.example>
CONTACT_TO=recipient@example.com

# Admin panel credentials and signed session secret (server-side only).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Admin uploads are stored in MongoDB GridFS. Complete HTTPS media URLs are also supported.
